<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="attack-paths" name="Attack paths">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1670" pageHeight="1918" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Attack paths — Hexagonal Student-Loan POC&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=26;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1000" height="44" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="How an attacker could chain the weaknesses in the threat model. Each row is one path from entry point to impact; T-numbers match the threat register in threat-model.drawio. Drawn from the code as built." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="990" height="40" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T7&lt;/b&gt; = threat ID · &lt;b style=&quot;color:#2e7d32&quot;&gt;C1&lt;/b&gt; = control that breaks the path (table at the bottom)&lt;br&gt;&lt;span style=&quot;color:#c62828&quot;&gt;&lt;b&gt;red arrows&lt;/b&gt;&lt;/span&gt; = the attacker's steps · rows are tinted by overall risk (red = high, orange = medium)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="8" width="610" height="84" as="geometry"/></mxCell>
        <mxCell id="h-path" value="&lt;b&gt;Path · who&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=12;color:#555555;" vertex="1" parent="1"><mxGeometry x="20" y="118" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="h-s0" value="&lt;b&gt;Step 1 · Entry&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="118" width="205" height="20" as="geometry"/></mxCell>
        <mxCell id="h-s1" value="&lt;b&gt;Step 2 · Exploit&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="483" y="118" width="205" height="20" as="geometry"/></mxCell>
        <mxCell id="h-s2" value="&lt;b&gt;Step 3 · Gain&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="716" y="118" width="205" height="20" as="geometry"/></mxCell>
        <mxCell id="h-s3" value="&lt;b&gt;Step 4 · Use it&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="949" y="118" width="205" height="20" as="geometry"/></mxCell>
        <mxCell id="h-goal" value="&lt;b&gt;Impact&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1182" y="118" width="230" height="20" as="geometry"/></mxCell>
        <mxCell id="h-rate" value="&lt;b&gt;Likelihood · impact · fix&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1430" y="118" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="AP1" value="&lt;b style=&quot;font-size:13px&quot;&gt;AP1  Read anyone's data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Anonymous network user&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="144" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="AP1s0" value="&lt;b&gt;Find a username&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Demo names are in the README; a 404 vs 200 on history URLs confirms which exist&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="250" y="144" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP1s1" value="&lt;b&gt;Open a history URL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET /api/payments/history?username=victim — no login needed&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="483" y="144" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP1s2" value="&lt;b&gt;Repeat for the rest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/api/profile/history and /api/chat-history, one username at a time&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="716" y="144" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP1s3" value="&lt;b&gt;Collect the results&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Email, phone, address, balances, full ledger, chat recaps&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="949" y="144" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP1g" value="&lt;b&gt;Mass disclosure of borrower personal and financial data&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b71c1c;strokeColor=#7f1d1d;fontFamily=Helvetica;fontSize=12;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1182" y="144" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="AP1r" value="&lt;b style=&quot;color:#c62828&quot;&gt;High likelihood · High impact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;break it with&lt;/font&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C1&lt;/b&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1430" y="144" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP1s0" target="AP1s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP1s1" target="AP1s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP1s2" target="AP1s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP1s3" target="AP1g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="AP2" value="&lt;b style=&quot;font-size:13px&quot;&gt;AP2  Hijack contact details&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Anonymous network user&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="AP2s0" value="&lt;b&gt;Find a username&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Same enumeration as AP1&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="250" y="260" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP2s1" value="&lt;b&gt;POST /api/profile as the victim&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Any well-formed email, phone and address is accepted; nothing proves identity&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="483" y="260" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP2s2" value="&lt;b&gt;Contact data replaced&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Saved to borrower_contact; the history row records no actor, IP or login&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="716" y="260" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP2s3" value="&lt;b&gt;Impersonate the victim&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Receive notices, social-engineer support, or lock the real owner out&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="949" y="260" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP2g" value="&lt;b&gt;Account takeover by impersonation; the victim cannot prove what happened&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b71c1c;strokeColor=#7f1d1d;fontFamily=Helvetica;fontSize=12;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1182" y="260" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="AP2r" value="&lt;b style=&quot;color:#c62828&quot;&gt;High likelihood · High impact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;break it with&lt;/font&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C1&lt;/b&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1430" y="260" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP2s0" target="AP2s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP2s1" target="AP2s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP2s2" target="AP2s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP2s3" target="AP2g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="AP3" value="&lt;b style=&quot;font-size:13px&quot;&gt;AP3  Forge payments and schedule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Malicious borrower (or anyone, using another username)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="376" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="AP3s0" value="&lt;b&gt;Log in as yourself&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A normal, valid session in the browser&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="250" y="376" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP3s1" value="&lt;b&gt;Craft POST /api/payments&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Edit the client in devtools or call the API directly; pick amount, apply-to, source&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="483" y="376" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP3s2" value="&lt;b&gt;Set schedule fields freely&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Next due date and amount, payments made and streak are only type-checked&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T3&lt;/b&gt; &lt;b style=&quot;color:#c62828&quot;&gt;T4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="716" y="376" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP3s3" value="&lt;b&gt;API accepts the request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ledger row, new balance and a clean schedule are saved; no money moved&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="949" y="376" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP3g" value="&lt;b&gt;Fake payments, hidden delinquency, a corrupted ledger&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b71c1c;strokeColor=#7f1d1d;fontFamily=Helvetica;fontSize=12;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1182" y="376" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="AP3r" value="&lt;b style=&quot;color:#c62828&quot;&gt;High likelihood · High impact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;break it with&lt;/font&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C2&lt;/b&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1430" y="376" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="a9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP3s0" target="AP3s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP3s1" target="AP3s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP3s2" target="AP3s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP3s3" target="AP3g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="AP4" value="&lt;b style=&quot;font-size:13px&quot;&gt;AP4  Take over an account&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Anonymous network user&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="492" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="AP4s0" value="&lt;b&gt;Collect usernames&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;README demo accounts and the 404 vs 200 oracle&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="250" y="492" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP4s1" value="&lt;b&gt;Guess passwords&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /api/login, unlimited attempts; every demo account shares one password&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="483" y="492" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP4s2" value="&lt;b&gt;Log in as the victim&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Full access: balances, history, payment and profile forms&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="716" y="492" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP4s3" value="&lt;b&gt;Change data or pay&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Replace contact details, record payments&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T3&lt;/b&gt; &lt;b style=&quot;color:#c62828&quot;&gt;T5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="949" y="492" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP4g" value="&lt;b&gt;Full takeover of a borrower account&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b71c1c;strokeColor=#7f1d1d;fontFamily=Helvetica;fontSize=12;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1182" y="492" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="AP4r" value="&lt;b style=&quot;color:#c62828&quot;&gt;High likelihood · High impact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;break it with&lt;/font&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C3&lt;/b&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1430" y="492" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="a13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP4s0" target="AP4s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP4s1" target="AP4s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP4s2" target="AP4s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP4s3" target="AP4g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="AP5" value="&lt;b style=&quot;font-size:13px&quot;&gt;AP5  Steal credentials from a leak&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Outsider holding the repo, DB file or a backup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="608" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="AP5s0" value="&lt;b&gt;Obtain the data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Public repo branch, stray backup, shared laptop, copied db file&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="250" y="608" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP5s1" value="&lt;b&gt;Read the passwords&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Plain text in user_authentication; demo123 in seed-data.mjs and the README&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="483" y="608" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP5s2" value="&lt;b&gt;Try them on a live system&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Shared and reused passwords work as they are&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="716" y="608" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP5s3" value="&lt;b&gt;Log in as every borrower&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Repeat AP4 step 3 for each account&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="949" y="608" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP5g" value="&lt;b&gt;Every credential exposed at once&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b71c1c;strokeColor=#7f1d1d;fontFamily=Helvetica;fontSize=12;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1182" y="608" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="AP5r" value="&lt;b style=&quot;color:#c62828&quot;&gt;Medium likelihood · High impact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;break it with&lt;/font&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C4&lt;/b&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1430" y="608" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="a17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP5s0" target="AP5s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP5s1" target="AP5s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP5s2" target="AP5s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP5s3" target="AP5g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="AP6" value="&lt;b style=&quot;font-size:13px&quot;&gt;AP6  Intercept traffic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Network attacker (only if exposed beyond localhost)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="724" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="AP6s0" value="&lt;b&gt;Reach the network path&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Shared Wi-Fi, a proxy, a compromised router&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="250" y="724" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP6s1" value="&lt;b&gt;Sniff the traffic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The app runs on plain HTTP, no TLS&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="483" y="724" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP6s2" value="&lt;b&gt;Capture secrets and data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Login bodies, balances, personal data in every response&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="716" y="724" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP6s3" value="&lt;b&gt;Replay or alter requests&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Change a payment or profile update in flight&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T8&lt;/b&gt; &lt;b style=&quot;color:#c62828&quot;&gt;T3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="949" y="724" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP6g" value="&lt;b&gt;Credential theft and request tampering&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b71c1c;strokeColor=#7f1d1d;fontFamily=Helvetica;fontSize=12;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1182" y="724" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="AP6r" value="&lt;b style=&quot;color:#c62828&quot;&gt;Medium likelihood · High impact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;break it with&lt;/font&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1430" y="724" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="a21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP6s0" target="AP6s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP6s1" target="AP6s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP6s2" target="AP6s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP6s3" target="AP6g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="AP7" value="&lt;b style=&quot;font-size:13px&quot;&gt;AP7  Poison a dependency&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Supply-chain attacker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="AP7s0" value="&lt;b&gt;Compromise a package&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A malicious or vulnerable npm module among 920 packages (71 flagged by npm audit today)&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T15&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="250" y="840" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP7s1" value="&lt;b&gt;Code runs on your machine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;During install, build or dev serve, on a laptop or in CI&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T15&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="483" y="840" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP7s2" value="&lt;b&gt;Read secrets and data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Azure key in the environment, the SQLite file, the source&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T9&lt;/b&gt; &lt;b style=&quot;color:#c62828&quot;&gt;T6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="716" y="840" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP7s3" value="&lt;b&gt;Exfiltrate or tamper&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Send it out, or alter the database or the build&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T15&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="949" y="840" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP7g" value="&lt;b&gt;Full compromise of data and secrets&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b71c1c;strokeColor=#7f1d1d;fontFamily=Helvetica;fontSize=12;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1182" y="840" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="AP7r" value="&lt;b style=&quot;color:#ef6c00&quot;&gt;Low likelihood · High impact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;break it with&lt;/font&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1430" y="840" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="a25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP7s0" target="AP7s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP7s1" target="AP7s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP7s2" target="AP7s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP7s3" target="AP7g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="AP8" value="&lt;b style=&quot;font-size:13px&quot;&gt;AP8  Flood the API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Anonymous network user&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="956" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="AP8s0" value="&lt;b&gt;Find the API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/api/* answers without a login&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T11&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="250" y="956" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP8s1" value="&lt;b&gt;Flood the writes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Thousands of POST /api/payments or /api/profile requests&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T11&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="483" y="956" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP8s2" value="&lt;b&gt;The SQLite lock queues up&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;One writer, BEGIN IMMEDIATE, 3 second busy timeout&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T11&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="716" y="956" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP8s3" value="&lt;b&gt;Real requests time out&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;No rate limit and no request timeout to shed the load&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T11&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="949" y="956" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP8g" value="&lt;b&gt;The service is unavailable to every borrower&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b71c1c;strokeColor=#7f1d1d;fontFamily=Helvetica;fontSize=12;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1182" y="956" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="AP8r" value="&lt;b style=&quot;color:#ef6c00&quot;&gt;Medium likelihood · Medium impact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;break it with&lt;/font&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C3&lt;/b&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1430" y="956" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="a29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP8s0" target="AP8s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP8s1" target="AP8s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP8s2" target="AP8s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP8s3" target="AP8g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="AP9" value="&lt;b style=&quot;font-size:13px&quot;&gt;AP9  Use the Azure relay&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Anyone who can reach the dev server (Azure mode only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="1072" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="AP9s0" value="&lt;b&gt;Reach /api/azure-ai&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The proxy forwards it with no authentication&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="250" y="1072" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP9s1" value="&lt;b&gt;The proxy adds the key&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The attacker never needs the api-key header; the proxy supplies it&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="483" y="1072" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP9s2" value="&lt;b&gt;Send any prompts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Unlimited volume, any content&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T11&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="716" y="1072" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP9s3" value="&lt;b&gt;Spend quota, misuse the model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;In directKey mode the key is also readable in the bundle&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="949" y="1072" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP9g" value="&lt;b&gt;Unauthorised Azure spend and misuse&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b71c1c;strokeColor=#7f1d1d;fontFamily=Helvetica;fontSize=12;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1182" y="1072" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="AP9r" value="&lt;b style=&quot;color:#ef6c00&quot;&gt;Medium likelihood · Medium impact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;break it with&lt;/font&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1430" y="1072" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="a33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP9s0" target="AP9s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP9s1" target="AP9s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP9s2" target="AP9s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP9s3" target="AP9g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="AP10" value="&lt;b style=&quot;font-size:13px&quot;&gt;AP10  Attack from any web page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Attacker-controlled website opened in the same browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="1188" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="AP10s0" value="&lt;b&gt;Lure a visitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A developer or borrower opens a hostile page while the app is running or reachable&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;R21&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="250" y="1188" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP10s1" value="&lt;b&gt;The page calls the API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fetch to http://localhost:4200/api/...; the dev server replies with Access-Control-Allow-Origin: *&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;R21&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="483" y="1188" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP10s2" value="&lt;b&gt;Read everything&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ledgers, contact details and chat history come back to the attacker's page&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;R21&lt;/b&gt; &lt;b style=&quot;color:#c62828&quot;&gt;T7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="716" y="1188" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP10s3" value="&lt;b&gt;Write with no preflight&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST with Content-Type text/plain is accepted; no Origin check, no CSRF token&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;R21&lt;/b&gt; &lt;b style=&quot;color:#c62828&quot;&gt;T1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=5;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="949" y="1188" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="AP10g" value="&lt;b&gt;Silent data theft and tampering through the victim's own browser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b71c1c;strokeColor=#7f1d1d;fontFamily=Helvetica;fontSize=12;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1182" y="1188" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="AP10r" value="&lt;b style=&quot;color:#c62828&quot;&gt;Medium likelihood · High impact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;break it with&lt;/font&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C10&lt;/b&gt; &lt;b style=&quot;color:#2e7d32&quot;&gt;C1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1430" y="1188" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="a37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP10s0" target="AP10s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP10s1" target="AP10s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP10s2" target="AP10s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="AP10s3" target="AP10g"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="blocked-title" value="&lt;b style=&quot;font-size:16px&quot;&gt;Paths that do NOT work today&lt;/b&gt; &lt;span style=&quot;font-size:12px&quot;&gt;— controls already in place; keep them when the app changes&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1318" width="1630" height="26" as="geometry"/></mxCell>
        <mxCell id="B0" value="&lt;b style=&quot;color:#2e7d32&quot;&gt;✗ SQL injection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;attempt: Request fields reach a query&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;blocked:&lt;/b&gt; Every query is a prepared statement; none is built from request text&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T13&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="1350" width="308" height="118" as="geometry"/></mxCell>
        <mxCell id="B1" value="&lt;b style=&quot;color:#2e7d32&quot;&gt;✗ Regex denial of service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;attempt: A crafted sentence hits the keyword router&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;blocked:&lt;/b&gt; Input capped at 2,000 characters, wildcards limited to 3 words, fixed patterns&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T12&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="346" y="1350" width="308" height="118" as="geometry"/></mxCell>
        <mxCell id="B2" value="&lt;b style=&quot;color:#2e7d32&quot;&gt;✗ Prompt injection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;attempt: Model output reaches money or SQL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;blocked:&lt;/b&gt; The model can only return a topic name or prose; the core stamps every figure&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T14&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="672" y="1350" width="308" height="118" as="geometry"/></mxCell>
        <mxCell id="B3" value="&lt;b style=&quot;color:#2e7d32&quot;&gt;✗ Read the Azure key from the bundle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;attempt: Open devtools in proxy mode&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;blocked:&lt;/b&gt; The key lives in the proxy's environment; the browser only calls a same-origin path&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="998" y="1350" width="308" height="118" as="geometry"/></mxCell>
        <mxCell id="B4" value="&lt;b style=&quot;color:#2e7d32&quot;&gt;✗ Read a password from the API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;attempt: Call login or any read endpoint&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;blocked:&lt;/b&gt; The API checks the password itself and never returns it in the borrower record&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#c62828&quot;&gt;T6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1324" y="1350" width="308" height="118" as="geometry"/></mxCell>
        <mxCell id="chokes" value="&lt;b style=&quot;font-size:16px&quot;&gt;Choke points — one fix, many paths&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;margin-top:6px;width:100%&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;width:34px;background:#eeeeee;font-weight:bold&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;width:210px;background:#eeeeee;font-weight:bold&quot;&gt;Control&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;width:620px;background:#eeeeee;font-weight:bold&quot;&gt;What it means here&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;width:250px;background:#eeeeee;font-weight:bold&quot;&gt;Breaks&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;width:466px;background:#eeeeee;font-weight:bold&quot;&gt;Why it matters&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold;color:#2e7d32&quot;&gt;C1&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;Authenticate and authorise every request on the server&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Issue a session or signed token at login; take the borrower from it, never from the request; apply it to every read and write&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;AP1 · AP2 · AP3 (against others) · AP4 step 4&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Closes the three high-likelihood data and fraud paths&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold;color:#2e7d32&quot;&gt;C2&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;Decide money on the server&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Run processPayment, applyPayment and applyProfileUpdate server-side; make payment references on the server; require an idempotency key&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;AP3&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;The client sends intent only; schedule fields can no longer be forged&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold;color:#2e7d32&quot;&gt;C3&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;Throttle and lock out&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Rate-limit login and writes per IP and account, lock out after repeated failures, add MFA, retire shared passwords&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;AP4 · AP5 · AP8&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Makes guessing and flooding expensive&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold;color:#2e7d32&quot;&gt;C4&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;Hash passwords and clean the repository&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Store argon2 or bcrypt hashes; remove credentials from seed-data.mjs and the README; rotate the demo passwords&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;AP5 (and weakens AP4)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;A leaked database no longer exposes credentials&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold;color:#2e7d32&quot;&gt;C5&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;Encrypt in transit&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Terminate TLS in front of the app, send HSTS&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;AP6&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Required before any exposure beyond localhost&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold;color:#2e7d32&quot;&gt;C6&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;Lock down the Azure path&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Require authentication on /api/azure-ai, set budget alerts and rate limits, never use directKey outside local spikes&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;AP9&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Only matters if Azure mode is switched on&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold;color:#2e7d32&quot;&gt;C7&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;Keep dependencies healthy&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Upgrade Angular to a patched release, run npm audit in CI, enable Dependabot, serve a production build&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;AP7&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Cheap and ongoing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold;color:#2e7d32&quot;&gt;C8&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;Authenticated audit log and alerts&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Record actor, IP and user agent for every request; alert on bursts, failed logins and unusual reads&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;AP1–AP4 · AP8 (detects)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;A detective control: makes the paths visible and attributable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold;color:#2e7d32&quot;&gt;C9&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;Answer uniformly&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Return the same response for an unknown username and an unauthorised one&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;AP1 · AP4 step 1&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Removes the username oracle; falls out of C1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold;color:#2e7d32&quot;&gt;C10&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;Block cross-site requests&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;SameSite=Strict session cookie plus a CSRF token on every write; check Origin and accept JSON only in the API; remove the wildcard CORS (dev server setting and any production proxy); give the dev server a private host name&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;AP10 (and hardens AP2 · AP3)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Found by testing: the dev server sends Access-Control-Allow-Origin: * and the API takes text/plain bodies&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;overflow=fill;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1488" width="1630" height="330" as="geometry"/></mxCell>
        <mxCell id="priority" value="&lt;b&gt;Where to start.&lt;/b&gt; C1 and C2 together close AP1, AP2 and AP3, the three paths that need no special skill and end in exposed data or falsified money; C10 (with C1) closes AP10, which needs no access to the victim machine at all. Add C3 and C4 next to stop account takeover. C5 is mandatory before the app is reachable from anywhere but this machine. Likelihood and impact are judgement calls for the app as built, not a measured score." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1832" width="1630" height="52" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
