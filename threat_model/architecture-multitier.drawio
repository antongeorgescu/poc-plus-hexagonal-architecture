        <mxCell id="root" value="&lt;b&gt;COMPOSITION ROOT&lt;/b&gt; — &lt;i&gt;providers.ts · tokens.ts&lt;/i&gt;: the &lt;b&gt;only&lt;/b&gt; place that names concrete classes; binds adapters to driven ports and services to driving ports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="690" width="1350" height="42" as="geometry"/></mxCell>
        <mxCell id="T2" value="TIER 2 — WEB / PROXY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9e9e9e;fontFamily=Helvetica;fontSize=12;fillColor=#f7f7f7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=1;dashPattern=8 6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="10" y="780" width="1650" height="95" as="geometry"/></mxCell>
        <mxCell id="proxy" value="&lt;b&gt;Dev-server / reverse proxy&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(ng serve :4200 in development)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;serves the static Angular bundle · forwards /api to the API · forwards /api/azure-ai to Azure (adds the key) · the production edge replaces this&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;fillColor=#fff7e6;" vertex="1" parent="1"><mxGeometry x="30" y="810" width="1620" height="55" as="geometry"/></mxCell>
        <mxCell id="T3" value="TIER 3 — APPLICATION (Node API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9e9e9e;fontFamily=Helvetica;fontSize=12;fillColor=#f7f7f7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=1;dashPattern=8 6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="10" y="890" width="1650" height="215" as="geometry"/></mxCell>
        <mxCell id="http" value="&lt;b&gt;HTTP layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;route table · body parsing (16 KB cap) · JSON shape checks · error mapping&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="925" width="300" height="78" as="geometry"/></mxCell>
        <mxCell id="handlers" value="&lt;b&gt;Request handlers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;login · record payment · save profile · history reads · jobs · chat history&lt;br&gt;one transaction per write&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="925" width="330" height="78" as="geometry"/></mxCell>
        <mxCell id="persist" value="&lt;b&gt;Persistence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;prepared statements through node:sqlite&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="925" width="300" height="78" as="geometry"/></mxCell>
        <mxCell id="lm" value="&lt;b&gt;Language model module&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(server/language-model/)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;keyword router + intents registry + narration templates — no LLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1020" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="authplan" value="&lt;b&gt;Session and authorization layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;planned — not in the POC today (authn-authz-design.md)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9e9e9e;fontFamily=Helvetica;fontSize=12;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="1020" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="azure" value="&lt;b&gt;Azure OpenAI&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(optional, external)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;off by default&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;shape=cloud;" vertex="1" parent="1"><mxGeometry x="1385" y="925" width="245" height="90" as="geometry"/></mxCell>
        <mxCell id="T4" value="TIER 4 — DATA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9e9e9e;fontFamily=Helvetica;fontSize=12;fillColor=#f7f7f7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=1;dashPattern=8 6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="10" y="1120" width="1650" height="135" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;SQLite&lt;/b&gt; — db/data/loanservicing.db&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;borrower · borrower_contact · loan · payment · payment_history · profile_update_history&lt;br&gt;chat_history · job_posting · user_authentication&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="1145" width="540" height="95" as="geometry"/></mxCell>
        <mxCell id="dbnote" value="Opened &lt;b&gt;only&lt;/b&gt; by the API. The browser never touches it, and it is git-ignored. Built by db/schema.sql, db/build.mjs and db/seed-data.mjs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1130" y="1155" width="500" height="60" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="actor" target="drvA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="inject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="drvA" target="dpg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="dpg" target="HEX"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="use" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="HEX" target="vpg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="impl." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="vpg" target="dvA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="HTTP /api/* (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.866;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="dvA" target="proxy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="/api/azure-ai (optional)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;dashed=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.97;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="aiz" target="proxy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="serves the static bundle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;exitX=0.127;exitY=0;exitDx=0;exitDy=0;entryX=0.915;entryY=1;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#666666;" edge="1" parent="1" source="proxy" target="drvA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="forwards /api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=0.185;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="proxy" target="http"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="http" target="handlers"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="handlers" target="persist"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="handlers" target="lm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e13" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="persist" target="db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="1110"/><mxPoint x="830" y="1110"/></Array></mxGeometry></mxCell>
        <mxCell id="e14" value="forwards /api/azure-ai" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;dashed=1;exitX=0.97;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="proxy" target="azure"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="howto" value="&lt;b&gt;How the hexagon maps onto the tiers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;1.&lt;/b&gt; The core, its ports and the UI are all in &lt;b&gt;Tier 1&lt;/b&gt;: in this POC the business rules run in the browser, which makes the browser the first thing a threat model must not trust.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; The only way out of the hexagon is a &lt;b&gt;driven port&lt;/b&gt; to an &lt;b&gt;HTTP adapter&lt;/b&gt;; every crossing into Tiers 2–4 is one of those calls, so the trust boundaries in the threat model fall on the adapters.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Tier 3 is a conventional layered service and is &lt;b&gt;not&lt;/b&gt; hexagonal; it owns the database, the keyword language model and the secrets.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Nothing in the core imports Angular, HTTP or SQL; swapping an adapter is a change to the composition root only.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1275" width="1630" height="112" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
