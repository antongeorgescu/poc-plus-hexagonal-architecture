<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="architecture-multitier" name="Architecture (multi-tier hexagonal)">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1690" pageHeight="1410" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Architecture — Hexagonal Student-Loan POC&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=26;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1000" height="44" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Hexagonal architecture (ports and adapters) laid out across the deployment tiers. &lt;b&gt;Dependencies point inward:&lt;/b&gt; adapters depend on ports, and the core depends on nothing outside itself. This is the foundation the threat-model diagram is drawn on." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="1000" height="44" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#82b366&quot;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/span&gt; port (interface the core owns) · &lt;span style=&quot;color:#d79b00&quot;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/span&gt; adapter (technology) · &lt;span style=&quot;color:#6c8ebf&quot;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/span&gt; BLL &lt;span style=&quot;color:#9673a6&quot;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/span&gt; CLL&lt;br&gt;solid arrow = call · dashed = optional or planned · port border colour = region it belongs to" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="8" width="600" height="84" as="geometry"/></mxCell>
        <mxCell id="T1" value="TIER 1 — PRESENTATION / CLIENT (the browser) — the Angular application, &lt;i&gt;including the whole hexagon&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9e9e9e;fontFamily=Helvetica;fontSize=12;fillColor=#f7f7f7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=1;dashPattern=8 6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="10" y="105" width="1650" height="650" as="geometry"/></mxCell>
        <mxCell id="hDriving" value="&lt;b&gt;DRIVING (PRIMARY) SIDE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;inbound — who calls the core&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="135" width="235" height="36" as="geometry"/></mxCell>
        <mxCell id="hCore" value="&lt;b&gt;THE CORE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pure TypeScript, zero framework imports&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="135" width="400" height="36" as="geometry"/></mxCell>
        <mxCell id="hDriven" value="&lt;b&gt;DRIVEN (SECONDARY) SIDE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;outbound — what the core calls&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="135" width="440" height="36" as="geometry"/></mxCell>
        <mxCell id="actor" value="&lt;b&gt;Borrower&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(browser user)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="235" height="30" as="geometry"/></mxCell>
        <mxCell id="drvA" value="&lt;b&gt;ADAPTERS · DRIVING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Angular UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;verticalAlign=top;fillOpacity=40;" vertex="1" parent="1"><mxGeometry x="20" y="225" width="235" height="440" as="geometry"/></mxCell>
        <mxCell id="ui1" value="&lt;b&gt;Login · Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ask box and question chips; routes a question to a card&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="32" y="262" width="211" height="62" as="geometry"/></mxCell>
