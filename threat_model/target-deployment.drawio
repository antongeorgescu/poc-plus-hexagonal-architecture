<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="target-deployment" name="Target deployment">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1670" pageHeight="1190" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Target deployment — Hexagonal Student-Loan POC&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=26;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1000" height="44" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="The production layout the remediation plan builds toward, with trust zones and the controls placed where they belong. Technology-neutral: names are examples. The POC today is one machine with no edge, no secrets store and no logging." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="980" height="44" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#2e7d32;font-size:10px&quot;&gt;REM-nn&lt;/b&gt; = the work item in remediation-plan.md that builds this component or control&lt;br&gt;dashed boxes = trust zones · solid arrows = allowed flows · &lt;span style=&quot;color:#c62828&quot;&gt;red dashed&lt;/span&gt; = what is stopped · orange = management plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="8" width="610" height="84" as="geometry"/></mxCell>
        <mxCell id="zInternet" value="ZONE 0 — Internet (untrusted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;dashed=1;dashPattern=8 6;fillColor=none;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;spacingBottom=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="230" height="400" as="geometry"/></mxCell>
        <mxCell id="zEdge" value="ZONE 1 — Edge (public)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;dashed=1;dashPattern=8 6;fillColor=none;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;spacingBottom=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="275" y="110" width="345" height="400" as="geometry"/></mxCell>
        <mxCell id="zApp" value="ZONE 2 — Application (private)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;dashed=1;dashPattern=8 6;fillColor=none;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;spacingBottom=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="645" y="110" width="370" height="400" as="geometry"/></mxCell>
        <mxCell id="zData" value="ZONE 3 — Data (private, no internet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;dashed=1;dashPattern=8 6;fillColor=none;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;spacingBottom=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="265" height="400" as="geometry"/></mxCell>
        <mxCell id="zExt" value="ZONE 4 — External services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;fontFamily=Helvetica;fontSize=12;dashed=1;dashPattern=8 6;fillColor=none;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;spacingBottom=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="110" width="300" height="400" as="geometry"/></mxCell>
        <mxCell id="borrower" value="&lt;b&gt;Borrower&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;browser on their own device&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="150" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="attacker" value="&lt;b&gt;Attacker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;anonymous · malicious borrower · hostile website&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="280" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="edge" value="&lt;b&gt;CDN · WAF · reverse proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TLS 1.2+ only, HSTS&lt;br&gt;rate limits, request timeouts, size caps&lt;br&gt;security headers, CSP, no wildcard CORS&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#2e7d32;font-size:10px&quot;&gt;REM-07 · REM-09 · REM-19&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="315" height="150" as="geometry"/></mxCell>
        <mxCell id="static" value="&lt;b&gt;Static site&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Angular bundle only, no source maps&lt;br&gt;self-hosted fonts, no third-party calls&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#2e7d32;font-size:10px&quot;&gt;REM-15 · REM-19&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="330" width="315" height="100" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;Data API&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(2+ instances, no inbound from the internet except the edge)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;server-side sessions, CSRF, Origin and JSON-only checks&lt;br&gt;every query scoped to the session&lt;br&gt;payment and profile &lt;b&gt;decisions made here&lt;/b&gt;, server-made references&lt;br&gt;login throttle and lockout · step-up for risky changes&lt;br&gt;audit event on every write and every denial&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#2e7d32;font-size:10px&quot;&gt;REM-01 · 03 · 04 · 05 · 06 · 08 · 21&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="150" width="340" height="190" as="geometry"/></mxCell>
        <mxCell id="kw" value="&lt;b&gt;Keyword language model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;in-process, no LLM&lt;br&gt;no outbound calls&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="365" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;encrypted at rest, TLS in transit&lt;br&gt;hashed passwords&lt;br&gt;least-privilege application role&lt;br&gt;no internet route&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#2e7d32;font-size:10px&quot;&gt;REM-02 · REM-13&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1055" y="150" width="235" height="150" as="geometry"/></mxCell>
        <mxCell id="backup" value="&lt;b&gt;Backups&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;encrypted, separate account&lt;br&gt;restore tested, ledger reconciled&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#2e7d32;font-size:10px&quot;&gt;REM-12&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1055" y="330" width="235" height="100" as="geometry"/></mxCell>
        <mxCell id="azure" value="&lt;b&gt;Azure OpenAI&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(optional)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reached only through an egress proxy&lt;br&gt;authenticated, rate-limited, budgeted&lt;br&gt;minimised payload, consent on file&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#2e7d32;font-size:10px&quot;&gt;REM-10&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1345" y="150" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="mail" value="&lt;b&gt;Notification service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reset links, contact-change and lockout notices&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1345" y="310" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="idp" value="&lt;b&gt;Identity provider&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(optional)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MFA, if not built in the API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1345" y="400" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="zMgmt" value="ZONE 5 — Management and security services (separate access, MFA, audited)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;dashed=1;dashPattern=8 6;fillColor=none;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=10;spacingTop=6;spacingBottom=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="275" y="545" width="1355" height="230" as="geometry"/></mxCell>
        <mxCell id="secrets" value="&lt;b&gt;Secrets manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;database credentials, Azure key&lt;br&gt;no secrets in the repo or the bundle&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#2e7d32;font-size:10px&quot;&gt;REM-02 · REM-10&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="585" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="logs" value="&lt;b&gt;Log pipeline → SIEM and alerts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;structured audit log, append-only&lt;br&gt;detections for AP1–AP10, drills&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#2e7d32;font-size:10px&quot;&gt;REM-08 · REM-16&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="585" width="340" height="120" as="geometry"/></mxCell>
        <mxCell id="ci" value="&lt;b&gt;CI/CD pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tests incl. security tests, npm audit&lt;br&gt;SBOM, signed build, supported Node&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color:#2e7d32;font-size:10px&quot;&gt;REM-11 · REM-14 · REM-20&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="585" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="admin" value="&lt;b&gt;Admin access&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;bastion, just-in-time, MFA&lt;br&gt;reaches Zones 2 and 3 only through it&lt;br&gt;no routine access to borrower data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="585" width="295" height="120" as="geometry"/></mxCell>
        <mxCell id="e1" value="1  HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="borrower" target="edge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#c62828;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.88;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#c62828;" edge="1" parent="1" source="attacker" target="edge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="edge" target="static"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="3  HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="edge" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="api" target="kw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="4  TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="db" target="backup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="7  allow-listed egress (Azure, notices, IdP)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;dashed=1;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.93;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="api" target="zExt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="104"/><mxPoint x="1609" y="104"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="5  secrets at start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;exitX=0.27;exitY=0;exitDx=0;exitDy=0;entryX=0.22;entryY=1;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#d79b00;" edge="1" parent="1" source="secrets" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e10" value="6  audit events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;exitX=0.97;exitY=1;exitDx=0;exitDy=0;entryX=0.12;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#d79b00;" edge="1" parent="1" source="api" target="logs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e11" value="10  deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#d79b00;" edge="1" parent="1" source="ci" target="static"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="closes" value="&lt;b style=&quot;font-size:15px&quot;&gt;What this topology closes&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;margin-top:6px;width:100%&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;width:330px;background:#eee;font-weight:bold&quot;&gt;Risks and attack paths&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;background:#eee;font-weight:bold&quot;&gt;How&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top;font-weight:bold&quot;&gt;T1 · T7 · R19 · R21 · AP1 AP2 AP4 AP10&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top&quot;&gt;Edge removes wildcard CORS; the API checks the session, CSRF token and Origin and scopes every query to the borrower (REM-01, 03, 04)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top;font-weight:bold&quot;&gt;T2 · AP4&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top&quot;&gt;Login throttle and lockout in the API, rate limits at the edge (REM-06, REM-09)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top;font-weight:bold&quot;&gt;T3 · T4 · AP3&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top&quot;&gt;Payment and profile decisions, and references, made on the server (REM-05)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top;font-weight:bold&quot;&gt;T5 · detection&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top&quot;&gt;Audit event on every write and denial, shipped to the SIEM with alerts (REM-08, REM-16)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top;font-weight:bold&quot;&gt;T6 · AP5 · R16&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top&quot;&gt;Hashed passwords; encrypted database and volume; secrets in a manager, not the repo (REM-02, 13)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top;font-weight:bold&quot;&gt;T8 · AP6&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top&quot;&gt;TLS 1.2+ at the edge and between tiers; HSTS (REM-07)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top;font-weight:bold&quot;&gt;T9 · T10 · R20 · AP9&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top&quot;&gt;Azure only through an authenticated, budgeted egress proxy with a minimised payload (REM-10)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top;font-weight:bold&quot;&gt;T11 · AP8&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top&quot;&gt;Rate limits, timeouts and size caps at the edge (REM-09)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top;font-weight:bold&quot;&gt;T15 · R18 · AP7&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top&quot;&gt;CI audit, SBOM, security tests and a supported runtime (REM-11, 14)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top;font-weight:bold&quot;&gt;R17 · R22&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 6px;vertical-align:top&quot;&gt;Tested encrypted backups and ledger reconciliation (REM-12); self-hosted fonts and CSP (REM-15)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;overflow=fill;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="795" width="1630" height="270" as="geometry"/></mxCell>
        <mxCell id="assume" value="&lt;b&gt;Assumptions.&lt;/b&gt; Cloud-neutral. SQLite can stay for a single-node deployment if the volume is encrypted, backups are tested and the API is the only writer; a managed SQL database is the better choice once more than one API instance writes. Whether Azure OpenAI and an external identity provider are used is the owner's decision; the diagram shows where they would sit." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1080" width="1630" height="52" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
