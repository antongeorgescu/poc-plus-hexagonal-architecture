<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="threat-model" name="Threat model">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1670" pageHeight="1760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Threat model — Hexagonal Student-Loan POC&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=26;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="960" height="44" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Data-flow diagram with trust boundaries and STRIDE threats, drawn from the code as built (local deployment). Risk is rated as if the app were reachable beyond localhost." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="940" height="40" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#c62828&quot;&gt;&lt;b&gt;●&lt;/b&gt;&lt;/span&gt; High &amp;nbsp; &lt;span style=&quot;color:#ef6c00&quot;&gt;&lt;b&gt;●&lt;/b&gt;&lt;/span&gt; Medium &amp;nbsp; &lt;span style=&quot;color:#2e7d32&quot;&gt;&lt;b&gt;●&lt;/b&gt;&lt;/span&gt; Low (or already mitigated)&lt;br&gt;T1…T15 = threat IDs in the register below (R16…R22 came from a later code review: register only) · dashed boxes = trust boundaries · &lt;span style=&quot;color:#c62828&quot;&gt;red dashed arrows&lt;/span&gt; = attacker paths" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="8" width="650" height="84" as="geometry"/></mxCell>
        <mxCell id="TB1" value="TRUST BOUNDARY 1 — User device&lt;br&gt;(untrusted: the user controls everything that runs here)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;dashed=1;dashPattern=8 6;fillColor=none;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=14;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="205" y="100" width="375" height="680" as="geometry"/></mxCell>
        <mxCell id="TB2" value="TRUST BOUNDARY 2&lt;br&gt;Application host&lt;br&gt;(server side; localhost&lt;br&gt;in the POC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;dashed=1;dashPattern=8 6;fillColor=none;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=14;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="750" height="680" as="geometry"/></mxCell>
        <mxCell id="TB3" value="TRUST BOUNDARY 3 — Data at rest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;dashed=1;dashPattern=8 6;fillColor=none;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=14;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="815" y="570" width="345" height="200" as="geometry"/></mxCell>
        <mxCell id="TB4" value="TRUST BOUNDARY 4 — External service (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;dashed=1;dashPattern=8 6;fillColor=none;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=14;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1375" y="100" width="255" height="680" as="geometry"/></mxCell>
        <mxCell id="borrower" value="&lt;b&gt;Borrower&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;legitimate user&lt;br&gt;types credentials, questions, forms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="160" height="100" as="geometry"/></mxCell>
        <mxCell id="attacker" value="&lt;b&gt;Attacker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;anonymous network user · malicious borrower · insider&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="160" height="120" as="geometry"/></mxCell>
        <mxCell id="spa" value="&lt;b&gt;Angular SPA&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(bundle served to the browser)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UI cards · hexagonal core (domain rules, validation, payment math) · API adapters&lt;br&gt;session kept in memory: the borrower record (no password) — no token, no cookie&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="170" width="345" height="260" as="geometry"/></mxCell>
        <mxCell id="devtools" value="&lt;b&gt;Browser devtools · extensions · intercepting proxies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;can read and change code, state and requests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="590" width="345" height="90" as="geometry"/></mxCell>
        <mxCell id="proxy" value="&lt;b&gt;Dev-server / reverse proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ng serve :4200 — serves the bundle, forwards /api&lt;br&gt;plain HTTP, no TLS · source maps on&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="615" y="200" width="200" height="330" as="geometry"/></mxCell>
        <mxCell id="secrets" value="&lt;b&gt;Secret: AZURE_OPENAI_API_KEY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;environment variable, read by the proxy (proxy mode only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="615" y="590" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;Data API&lt;/b&gt; — server/api.mjs (Node :3000)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;binds 127.0.0.1 only · 16 KB body cap&lt;br&gt;login · payments · profile · histories · jobs · chat · language-model&lt;br&gt;&lt;b&gt;identifies the caller only by the &quot;username&quot; in the request&lt;/b&gt;&lt;br&gt;no session · no rate limit · no request log&lt;br&gt;re-checks balance arithmetic · prepared SQL · one transaction per write&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="850" y="170" width="260" height="360" as="geometry"/></mxCell>
        <mxCell id="kw" value="&lt;b&gt;Keyword language model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;router + templates, no LLM&lt;br&gt;input ≤ 2,000 chars · bounded wildcards&lt;br&gt;returns a topic name or prose only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1130" y="170" width="205" height="170" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;SQLite&lt;/b&gt; — db/data/loanservicing.db&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;borrowers · loans · payments · ledgers · contact details&lt;br&gt;&lt;b&gt;passwords stored in plain text&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="875" y="590" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="azure" value="&lt;b&gt;Azure OpenAI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;optional · HTTPS&lt;/font&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1385" y="230" width="235" height="150" as="geometry"/></mxCell>
        <mxCell id="sent" value="&lt;b&gt;Data sent when Azure is on&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;question text · first name · standing tier&lt;br&gt;plus loan and payment figures for narration: balances, rate, due dates, payments made / missed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1385" y="430" width="235" height="150" as="geometry"/></mxCell>
        <mxCell id="e1" value="F1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="borrower" target="spa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="F2 HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.18;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="spa" target="proxy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="F3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.36;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="proxy" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="F4 SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="F5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="api" target="kw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="F6  HTTPS + api-key header (optional)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="proxy" target="azure"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="715" y="122"/><mxPoint x="1502" y="122"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="key injected into F6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#d79b00;" edge="1" parent="1" source="secrets" target="proxy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="F7  direct HTTP: forged username, brute force, flooding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#c62828;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.88;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#c62828;" edge="1" parent="1" source="attacker" target="proxy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="F8  tamper / replay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#c62828;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.88;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#c62828;" edge="1" parent="1" source="attacker" target="spa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b3" value="T3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c62828;strokeColor=#c62828;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b4" value="T4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef6c00;strokeColor=#ef6c00;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="490" y="130" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b8" value="T8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef6c00;strokeColor=#ef6c00;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="574" y="198" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b15" value="T15" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef6c00;strokeColor=#ef6c00;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="625" y="154" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b11" value="T11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef6c00;strokeColor=#ef6c00;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="675" y="154" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b9" value="T9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef6c00;strokeColor=#ef6c00;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="750" y="545" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b1" value="T1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c62828;strokeColor=#c62828;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b2" value="T2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c62828;strokeColor=#c62828;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="910" y="130" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b5" value="T5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef6c00;strokeColor=#ef6c00;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="960" y="130" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b7" value="T7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c62828;strokeColor=#c62828;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1010" y="130" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b12" value="T12" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#2e7d32;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1140" y="130" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b6" value="T6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c62828;strokeColor=#c62828;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="822" y="610" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b13" value="T13" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#2e7d32;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="822" y="665" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b10" value="T10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef6c00;strokeColor=#ef6c00;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1395" y="392" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b14" value="T14" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#2e7d32;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1445" y="392" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="flows" value="&lt;b&gt;Data flows.&lt;/b&gt; &lt;b&gt;F1&lt;/b&gt; credentials, questions and forms typed by the borrower · &lt;b&gt;F2&lt;/b&gt; HTTP requests to /api/* and the static bundle, in plain text · &lt;b&gt;F3&lt;/b&gt; the proxy forwards /api to 127.0.0.1:3000 · &lt;b&gt;F4&lt;/b&gt; prepared SQL: reads and transactional writes · &lt;b&gt;F5&lt;/b&gt; classify / narrate calls to the keyword model · &lt;b&gt;F6&lt;/b&gt; HTTPS to Azure OpenAI with the api-key header (optional) · &lt;b&gt;F7&lt;/b&gt; an attacker sends HTTP straight to the proxy · &lt;b&gt;F8&lt;/b&gt; an attacker alters the client or replays its requests." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="790" width="1630" height="60" as="geometry"/></mxCell>
        <mxCell id="register" value="&lt;b style=&quot;font-size:16px&quot;&gt;Threat register (STRIDE)&lt;/b&gt; &lt;span style=&quot;font-size:11px&quot;&gt;— T = from the data-flow review, R = added after reading the code&lt;/span&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;margin-top:6px;width:100%&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;width:36px;background:#eeeeee;font-weight:bold&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;width:100px;background:#eeeeee;font-weight:bold&quot;&gt;STRIDE&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;width:110px;background:#eeeeee;font-weight:bold&quot;&gt;Where&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;width:520px;background:#eeeeee;font-weight:bold&quot;&gt;Threat — what could go wrong&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;width:70px;background:#eeeeee;font-weight:bold&quot;&gt;Risk&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;width:764px;background:#eeeeee;font-weight:bold&quot;&gt;Existing control → recommended mitigation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T1&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Spoofing / Elevation&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Data API (F2–F3)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;The API identifies the caller only by the &lt;code&gt;username&lt;/code&gt; field in the request. Nothing proves who is calling, so anyone can read or change another borrower's data (insecure direct object reference).&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#c62828;font-weight:bold&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;None today → issue a server-side session or signed token at login, derive the borrower from it, and ignore any username in the request.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T2&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Spoofing&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Login (F2, F7)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;No rate limit or lockout on &lt;code&gt;/api/login&lt;/code&gt;, and every demo account shares one password, so brute force and credential stuffing succeed.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#c62828;font-weight:bold&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;None today → rate-limit and lock out per IP and per account, remove shared/default passwords, add MFA for real users.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T3&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Tampering&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Angular SPA (F8)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Payment amounts, balances and schedule changes are decided by code running in the browser. A modified client can choose any outcome the API's consistency checks still accept.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#c62828;font-weight:bold&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;API re-checks the balance arithmetic and rejects stale balances → move the decisions (processPayment, applyPayment, applyProfileUpdate) to the server; the client sends only intent.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T4&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Tampering&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;SPA → API (F2)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Payment reference numbers are generated in the browser with &lt;code&gt;Math.random&lt;/code&gt;, and there is no idempotency key, so a request can be replayed or a reference chosen by the attacker.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#ef6c00;font-weight:bold&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;UNIQUE reference plus the stale-balance check blunt simple replays → generate references on the server and require an idempotency key.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T5&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Repudiation&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Data API · SQLite&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;History rows record a reference and a time, but not who made the request, from where, or under what authentication, and the API keeps no request log. An actor can deny an action.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#ef6c00;font-weight:bold&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;History tables are append-only in practice → add an authenticated audit log (actor, IP, user agent) in tamper-evident storage.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T6&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Information disclosure&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;SQLite (F4)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Passwords are stored in plain text in &lt;code&gt;user_authentication&lt;/code&gt;, and the demo passwords are in the seed file and the README. A database or repository leak exposes every credential.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#c62828;font-weight:bold&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;The API never returns the password to the browser → store salted hashes (argon2 or bcrypt) and keep seed credentials out of the repository.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T7&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Information disclosure&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Data API (F3)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Read endpoints (payment history, profile history, chat history) return a borrower's personal data and ledger to any caller who supplies a username.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#c62828;font-weight:bold&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Same root cause as T1 → authorise every read against the authenticated borrower.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T8&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Information disclosure&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;F2 · F3&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Traffic is plain HTTP: credentials, personal data and balances can be read or altered by anyone on the network path.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#ef6c00;font-weight:bold&quot;&gt;Medium (High if exposed)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;API binds to 127.0.0.1 only → terminate TLS in front of the app and send HSTS.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T9&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Information disclosure&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Browser · secret&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;In &lt;code&gt;directKey&lt;/code&gt; mode the Azure key is compiled into the bundle and visible in devtools. Proxy mode keeps it on the server.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#ef6c00;font-weight:bold&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Proxy mode injects the key server-side → never use directKey outside local spikes; rotate any key that was exposed.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T10&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Information disclosure&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;F6 → Azure&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;With Azure enabled, the borrower's question text, first name and standing tier leave your boundary, &lt;b&gt;and so do the loan and payment figures used for narration&lt;/b&gt;: program of study, original and current balance, interest rate, maturity date, amounts due, payments made and missed (privacy, data residency, retention at the provider).&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#ef6c00;font-weight:bold&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Off by default → document exactly what is sent, get consent, check the provider's retention and region terms, and have narration send rounded or relative figures instead of exact ones.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T11&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Denial of service&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Proxy · API · SQLite&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;No rate limiting or timeouts, and SQLite has one writer (&lt;code&gt;BEGIN IMMEDIATE&lt;/code&gt;), so a flood of writes can starve every other borrower.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#ef6c00;font-weight:bold&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;16 KB body cap and short transactions → rate-limit, set request timeouts and connection caps at the edge.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T12&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Denial of service&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Keyword model (F5)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;A crafted sentence could burn CPU in the keyword router through regex backtracking.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#2e7d32;font-weight:bold&quot;&gt;Low&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Mitigated: input capped at 2,000 characters, wildcards bounded to 3 words, fixed patterns → keep the cap and fuzz-test new keywords.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T13&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Tampering&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;API → SQLite (F4)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;SQL injection through any request field.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#2e7d32;font-weight:bold&quot;&gt;Low&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Mitigated: every query is a prepared statement and none is built from request text → keep it that way; lint for string-built SQL.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T14&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Elevation of privilege&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;F6 · language model&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Prompt injection through free text, if Azure is enabled, to steer routing or the generated wording.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#2e7d32;font-weight:bold&quot;&gt;Low&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Mitigated by design: the model can only return a topic name or prose; the core stamps determinism and every figure → never let model output reach SQL or money.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;T15&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Tampering / Elevation&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Dev server · dependencies&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;&lt;code&gt;npm audit&lt;/code&gt; flags 8 of the 11 runtime packages (20 distinct advisories, 9 of them XSS or sanitisation bypasses, worst CVSS 9.0) and 71 of all 920 packages including build tooling (4 critical, 38 high). This app uses none of the affected features (i18n, innerHTML, SVG, HttpClient, SSR), so exposure is likely low, but the fix is a major-version upgrade. The experimental &lt;code&gt;node:sqlite&lt;/code&gt;, a non-LTS Node and a dev server with source maps are also in the stack.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#ef6c00;font-weight:bold&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Lockfile is committed → plan the major Angular upgrade, run &lt;code&gt;npm audit&lt;/code&gt; in CI, enable Dependabot, move to an LTS Node, and serve a production build.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;R16&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Information disclosure&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;SQLite file (F4)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;The SQLite file is unencrypted and readable by other accounts on a shared machine, and holds personal data and plain-text credentials.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#ef6c00;font-weight:bold&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;File is git-ignored → restrict file permissions, encrypt the volume or the database, and encrypt any backups.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;R17&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Denial of service / Integrity&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;db/build.mjs · SQLite&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;There is no backup or recovery, and &lt;code&gt;npm run db:build&lt;/code&gt; drops and recreates every table, erasing payments and profile updates made through the app.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#ef6c00;font-weight:bold&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;None today → scheduled, encrypted backups; a guard that refuses to run db:build against a database holding real data; a tested restore.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;R18&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Process&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Build · test&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;No automated security testing: no authorisation, abuse or fuzz tests, and no pipeline to run any tests. Only the keyword router has tests.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#ef6c00;font-weight:bold&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;11 router tests exist → add API authorisation and tampering tests; run tests and &lt;code&gt;npm audit&lt;/code&gt; in CI.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;R19&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Information disclosure&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;History · chat endpoints&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;An unknown username returns 404 and a real one 200, so an attacker can confirm which accounts exist.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#ef6c00;font-weight:bold&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Login messages are already uniform → answer unknown and unauthorised identically (falls out of the T1 fix).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;R20&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Elevation / DoS&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Proxy /api/azure-ai&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Open relay: anyone who can reach the dev server can send prompts through &lt;code&gt;/api/azure-ai&lt;/code&gt;, and the proxy adds the key for them. Azure mode only.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#ef6c00;font-weight:bold&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;None today → authenticate the route, rate-limit it, and set a spend budget with alerts.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;R21&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Spoofing / Tampering&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Dev server · API (F2)&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Any web page can talk to the API from a visitor's browser: the dev server adds &lt;code&gt;Access-Control-Allow-Origin: *&lt;/code&gt; and answers CORS preflights, the API accepts &lt;code&gt;text/plain&lt;/code&gt; bodies and checks neither Origin nor Content-Type, and there is no CSRF defence.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#c62828;font-weight:bold&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;None today → authenticate (C1), SameSite cookies plus a CSRF token, strict Origin and Content-Type checks in the API, and remove the wildcard CORS.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;font-weight:bold&quot;&gt;R22&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Information disclosure / Tampering&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;Browser → third party&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;The page loads a stylesheet from &lt;code&gt;fonts.googleapis.com&lt;/code&gt; on every view. That sends each visitor's IP address and user agent to a third party, makes the UI depend on an outside service staying available and unchanged, and rules out a strict Content-Security-Policy.&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top;color:#2e7d32;font-weight:bold&quot;&gt;Low&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:3px 5px;vertical-align:top&quot;&gt;None today → self-host the font files (or use system fonts), then set a Content-Security-Policy with &lt;code&gt;default-src 'self'&lt;/code&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;overflow=fill;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="870" width="1630" height="800" as="geometry"/></mxCell>
        <mxCell id="assume" value="&lt;b&gt;Assumptions &amp; scope.&lt;/b&gt; Assets: borrower personal data (name, address, email, phone, credit score), loan balances and payment ledger, credentials, and the optional Azure key. Rated for the app as built — a single-machine demo with seeded data. Out of scope: the host OS, the physical machine, GitHub account security and the people who operate the app." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1685" width="1630" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
