        <mxCell id="dp5" value="&lt;b&gt;LanguageModelPort&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;classify · narrate · describeTone · composeWelcome&lt;br&gt;words in, words out — never a number&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1545" y="772" width="210" height="100" as="geometry"/></mxCell>
