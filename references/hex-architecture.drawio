        <mxCell id="ad5" value="&lt;b&gt;ApiLanguageModel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /api/language-model/*&lt;br&gt;→ server keyword model, no LLM&lt;br&gt;&lt;b&gt;AzureAiLanguageModel&lt;/b&gt; optional&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1855" y="772" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="proxy" value="&lt;b&gt;Dev-server proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ng serve :4200&lt;br&gt;/api → data API · /api/azure-ai → Azure (key added here)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2190" y="172" width="285" height="100" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;Data API&lt;/b&gt; — server/api.mjs (Node :3000)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /api/login · /api/payments · /api/profile&lt;br&gt;GET /api/payments/history ★ · /api/profile/history ★&lt;br&gt;GET /api/jobs · /api/chat-history&lt;br&gt;&lt;b&gt;POST /api/language-model/*&lt;/b&gt; → keyword router +&lt;br&gt;templates (server/language-model/, no LLM)&lt;br&gt;one transaction per write · refuses stale or inconsistent writes&lt;br&gt;passwords never leave this process&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2190" y="297" width="285" height="195" as="geometry"/></mxCell>
        <mxCell id="sqlite" value="&lt;b&gt;SQLite&lt;/b&gt; — db/data/loanservicing.db&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;borrower · borrower_contact · loan · payment&lt;br&gt;payment_history ★ · profile_update_history ★&lt;br&gt;job_posting · chat_history · user_authentication&lt;br&gt;built by db/schema.sql + db/build.mjs&lt;br&gt;+ db/seed-data.mjs (seeded history, catalog)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1"><mxGeometry x="2190" y="522" width="285" height="215" as="geometry"/></mxCell>
        <mxCell id="azure" value="&lt;b&gt;Azure OpenAI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;optional · HTTPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;shape=cloud;" vertex="1" parent="1"><mxGeometry x="2190" y="790" width="285" height="85" as="geometry"/></mxCell>
