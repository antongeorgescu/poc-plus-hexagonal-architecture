        <mxCell id="ad2" value="&lt;b&gt;ApiProfileRepository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /api/profile&lt;br&gt;GET /api/profile/history ★&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1855" y="412" width="240" height="100" as="geometry"/></mxCell>
