        <mxCell id="PersonalizationService" value="&lt;b&gt;PersonalizationService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;theme policy · appends the 2 fixed&lt;br&gt;record questions ★&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1092" y="565" width="253" height="70" as="geometry"/></mxCell>
        <mxCell id="ChatInsightsService" value="&lt;b&gt;ChatInsightsService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sentiment bands&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="650" width="262" height="60" as="geometry"/></mxCell>
        <mxCell id="AccountSummaryService" value="&lt;b&gt;AccountSummaryService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;aggregates 3 BLL ports + narration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1092" y="650" width="253" height="60" as="geometry"/></mxCell>
        <mxCell id="policy" value="&lt;b&gt;Inquiry policy&lt;/b&gt; (values bound at the composition root)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;10 topics · determinism map (BLL topics: NEXT_PAYMENT, LOAN_BALANCE, EXTRA_PAYMENT, PROFILE_UPDATE, PAYMENT_HISTORY ★, PROFILE_HISTORY ★)&lt;br&gt;labels · descriptions — the model never sees the map&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="815" y="725" width="530" height="108" as="geometry"/></mxCell>
        <mxCell id="cllToBll" value="CLL knocks on BLL driving ports&lt;br&gt;(same doors as the UI)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673a6;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="AccountSummaryService" target="BLL"><mxGeometry relative="1" as="geometry"/></mxCell>
