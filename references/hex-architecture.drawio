        <mxCell id="legendStar" value="★ added with the record look-ups: history cards, ports, endpoints and tables" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1200" width="470" height="40" as="geometry"/></mxCell>
        <mxCell id="notes" value="&lt;b&gt;How a request travels&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Read:&lt;/b&gt; Dashboard → InquiryPort.classify (CLL proposes a topic, the core stamps the determinism flag) → answer card → driving port (BLL) → domain → driven port → adapter → &lt;i&gt;/api&lt;/i&gt; → SQLite.&lt;br&gt;&lt;b&gt;History ★:&lt;/b&gt; PaymentHistoryComponent → PaymentPort.getHistory → PaymentRepositoryPort.history → GET /api/payments/history → &lt;i&gt;domain orders newest first, totals, marks changed fields&lt;/i&gt;.&lt;br&gt;&lt;b&gt;Write:&lt;/b&gt; MakePaymentComponent → PaymentPort.submit → &lt;i&gt;domain decides&lt;/i&gt; (processPayment, applyPayment) → PaymentRepositoryPort.record → POST /api/payments → one transaction: payment_history + loan + payment. Profile updates follow the same shape.&lt;br&gt;&lt;b&gt;Rule of the hexagon:&lt;/b&gt; nothing in the core imports Angular or an adapter; the arrows always cross a port. The CLL proposes, the BLL disposes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="1062" width="1600" height="165" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
